<Window x:Class="RevitApiOnline.Wpf.GridLearn"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RevitApiOnline.Wpf"
             mc:Ignorable="d" 
             Height="500" Width="800">


    <Window.Resources>
        <Style x:Key="textBlockStype" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Aquamarine"></Setter>
            <Setter Property="FontSize" Value="20"></Setter>
            <Setter Property="Background" Value="Olive"></Setter>
        </Style>
        <Style x:Key="textBlockStyle2" TargetType="Label">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Background" Value="Cornsilk"/>
        </Style>
    </Window.Resources>
    <Grid Margin="5 15 5 5">

        <!--Bố Cục Tổng-->
        <Grid.RowDefinitions>
            <RowDefinition Height="1.5*"></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition/>
            <RowDefinition Height="30"/>
            <!--30 là fit cứng khoảng cách-->
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition/>
            <ColumnDefinition Width="110"/>
        </Grid.ColumnDefinitions>
        <!--Bố Cục Tổng-->

        <TextBlock Style="{StaticResource textBlockStype}" Grid.Row="1" Grid.Column="1" Text="WallType"></TextBlock>
        <TextBlock Style="{StaticResource textBlockStype}"  Grid.Row="2" Grid.Column="0" Text="Column"/>
        <TextBlock  Grid.Row="0" Grid.Column="2" Text="AAACCC"/>
        <TextBlock Grid.Row="3" Grid.Column="2" FontSize="20">
            <Italic> AAA </Italic> BBB
        </TextBlock>

        <Grid Grid.Row="0" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderThickness="1 1 0 1" BorderBrush="Black"/>
            <Border Grid.Row="0"  Grid.Column="1" BorderThickness="1" BorderBrush="Black">
                <TextBlock Text="Form"/>
            </Border>
            <Border Grid.Column="2"  BorderThickness="0 1 1 1" BorderBrush="Black">
                <Label Content="Binh"/>
            </Border>

            <Label Grid.ColumnSpan="3" HorizontalAlignment="Center" Grid.Row="1" Content="BEAM"/>

            <TextBox x:Name="textBoxDemo" Height="20" HorizontalAlignment="Center" Grid.ColumnSpan="3" Grid.Row="2" Text="COMPANY"/>
        </Grid>


    </Grid>
</Window>
